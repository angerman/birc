# SPDX-License-Identifier: Apache-2.0
# birc provisioning. Bend 2 is pinned as a non-flake source input; its
# identity (rev + narHash) lives in flake.lock, generated by `make bootstrap`
# (nix flake lock), never hand-written. Routine targets use
# --no-update-lock-file; only `make update CONFIRM=yes` may move pins.
{
  description = "birc — IRC client in Bend 2 + timui.h";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

  # Bend 2 (bendlang/bend), pinned to an immutable commit.
  inputs.bend-src = {
    url = "github:bendlang/bend/7d8a3eb036042c6549461054d25a10f26d361c5c";
    flake = false;
  };

  outputs = { self, nixpkgs, bend-src }:
    let
      systems = [ "aarch64-darwin" "x86_64-linux" "aarch64-linux" "x86_64-darwin" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
    in {
      packages = forAllSystems (system:
        let
          pkgs = import nixpkgs { inherit system; };
          bend = pkgs.callPackage ./nix/bend.nix { inherit bend-src; };
          birc = pkgs.callPackage ./nix/birc.nix { inherit bend; };
        in {
          inherit bend birc;
          default = birc;
        });

      apps = forAllSystems (system: {
        default = {
          type = "app";
          program = "${self.packages.${system}.birc}/bin/birc";
        };
        birc = {
          type = "app";
          program = "${self.packages.${system}.birc}/bin/birc";
        };
        keychain-birc = {
          type = "app";
          program = "${self.packages.${system}.birc}/bin/keychain-birc";
        };
      });

      devShells = forAllSystems (system:
        let
          pkgs = import nixpkgs { inherit system; };
          bend = self.packages.${system}.bend;
          media = pkgs.callPackage ./nix/media.nix {};
          upload = pkgs.callPackage ./nix/upload.nix {};
        in {
          default = pkgs.mkShell {
            packages = with pkgs; [
              bend bun clang (python3.withPackages (packages: [ packages.pillow ])) media upload
              bashInteractive gnumake git
              coreutils findutils gnugrep gnused gawk
              diffutils file which cacert
            ];
            BIRC_NIX_SHELL = "1";
            BIRC_BEND_SRC = "${bend-src}";
            BIRC_BEND_REV = "7d8a3eb036042c6549461054d25a10f26d361c5c";
            CC = "${pkgs.clang}/bin/clang";
            shellHook = ''
              export PYTHONDONTWRITEBYTECODE=1
            '';
          };
        });
    };
}
