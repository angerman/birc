# SPDX-License-Identifier: Apache-2.0
# birc provisioning. Bend 2 is pinned as a non-flake source input; its
# identity (rev + narHash) lives in flake.lock, generated by `make bootstrap`
# (nix flake lock), never hand-written. Routine targets use
# --no-update-lock-file; only `make update CONFIRM=yes` may move pins.
{
  description = "birc — IRC client in Bend 2 + timui.h";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

  # Bend 2 (bendlang/bend), pinned to an immutable commit (v2.0.38).
  inputs.bend-src = {
    url = "github:bendlang/bend/0a57ca0d21de94a3724d8be21afb0eb89f88b4d8";
    flake = false;
  };

  outputs = { self, nixpkgs, bend-src }:
    let
      systems = [ "aarch64-darwin" "x86_64-linux" "aarch64-linux" "x86_64-darwin" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
    in {
      packages = forAllSystems (system:
        let
          pkgs = import nixpkgs { inherit system; };
          bend = pkgs.callPackage ./nix/bend.nix { inherit bend-src; };
          birc = pkgs.callPackage ./nix/birc.nix { inherit bend; };
        in {
          inherit bend birc;
          birc-profiled = birc.override { profileBuild = true; };
          default = birc;
        });

      apps = forAllSystems (system: {
        default = {
          type = "app";
          program = "${self.packages.${system}.birc}/bin/birc";
        };
        birc = {
          type = "app";
          program = "${self.packages.${system}.birc}/bin/birc";
        };
        keychain-birc = {
          type = "app";
          program = "${self.packages.${system}.birc}/bin/keychain-birc";
        };
      });

      # ci.zw3rk.com schedules hydraJobs only. This job is the installed
      # client, which includes bin/keychain-birc. The profiled package stays local.
      hydraJobs = forAllSystems (system: {
        birc = self.packages.${system}.birc;
      });

      devShells = forAllSystems (system:
        let
          pkgs = import nixpkgs { inherit system; };
          bend = self.packages.${system}.bend;
          tlsCflags = "-isystem ${pkgs.lib.getDev pkgs.openssl}/include";
          tlsLdflags = "-L${pkgs.lib.getLib pkgs.openssl}/lib -rpath ${pkgs.lib.getLib pkgs.openssl}/lib -lssl -lcrypto";
        in {
          default = pkgs.mkShell {
            packages = with pkgs; [
              bend bun clang python3
              bashInteractive gnumake git
              coreutils findutils gnugrep gnused gawk
              diffutils file which cacert openssl.dev openssl.bin
            ];
            BIRC_NIX_SHELL = "1";
            BIRC_BEND_SRC = "${bend-src}";
            BIRC_BEND_REV = "0a57ca0d21de94a3724d8be21afb0eb89f88b4d8";
            CC = "${pkgs.clang}/bin/clang";
            BIRC_OPENSSL_DEV = "${pkgs.lib.getDev pkgs.openssl}";
            BIRC_OPENSSL_LIB = "${pkgs.lib.getLib pkgs.openssl}";
            BIRC_OPENSSL_BIN = "${pkgs.lib.getBin pkgs.openssl}";
            BIRC_TLS_CA = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
            BIRC_NIX_CC_SUFFIX = pkgs.clang.suffixSalt;
            BIRC_TLS_CFLAGS = tlsCflags;
            BIRC_TLS_LDFLAGS = tlsLdflags;
            # Bend invokes CC with fixed arguments. Salted flags also work
            # when a captured environment has no Nix compiler HOST role.
            "NIX_CFLAGS_COMPILE_${pkgs.clang.suffixSalt}" = tlsCflags;
            "NIX_LDFLAGS_${pkgs.clang.suffixSalt}" = tlsLdflags;
            SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
            shellHook = ''
              export PYTHONDONTWRITEBYTECODE=1
              # nix develop can omit SSL_CERT_FILE from captured attributes.
              export SSL_CERT_FILE="''${SSL_CERT_FILE:-$BIRC_TLS_CA}"
              # Persistent Bun cache for direct `bun` use (the `bend` wrapper
              # applies the same precedence). An explicit
              # BUN_INSTALL_CACHE_DIR, BIRC_BUN_CACHE, or
              # BIRC_BUN_TMPDIR_CACHE=1 override keeps working.
              if [ -z "''${BUN_INSTALL_CACHE_DIR:-}" ]; then
                if [ -n "''${BIRC_BUN_CACHE:-}" ]; then
                  export BUN_INSTALL_CACHE_DIR="$BIRC_BUN_CACHE"
                elif [ "''${BIRC_BUN_TMPDIR_CACHE:-0}" != "1" ]; then
                  if [ -n "''${XDG_CACHE_HOME:-}" ]; then
                    export BUN_INSTALL_CACHE_DIR="$XDG_CACHE_HOME/birc/bun"
                  elif [ -n "''${HOME:-}" ]; then
                    export BUN_INSTALL_CACHE_DIR="$HOME/.cache/birc/bun"
                  fi
                fi
              fi
              if [ -n "''${BUN_INSTALL_CACHE_DIR:-}" ] && [ -z "''${BUN_RUNTIME_TRANSPILER_CACHE_PATH:-}" ]; then
                export BUN_RUNTIME_TRANSPILER_CACHE_PATH="$BUN_INSTALL_CACHE_DIR/transpiler"
              fi
              # Toolchain cache (default-off): only a persistent directory is
              # defined; CC is unchanged, so builds behave exactly as before
              # unless the user explicitly runs ccache/sccache themselves.
              if [ -z "''${CCACHE_DIR:-}" ]; then
                if [ -n "''${XDG_CACHE_HOME:-}" ]; then
                  export CCACHE_DIR="$XDG_CACHE_HOME/birc/ccache"
                elif [ -n "''${HOME:-}" ]; then
                  export CCACHE_DIR="$HOME/.cache/birc/ccache"
                fi
              fi
            '';
          };
        });
    };
}
